<svg width="800" height="500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="dashGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a26;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#252538;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#dashGrad)"/>
  <text x="400" y="250" font-family="Arial, sans-serif" font-size="48" fill="#6366f1" text-anchor="middle" font-weight="bold">Dashboard Screenshot</text>
  <text x="400" y="300" font-family="Arial, sans-serif" font-size="24" fill="#b4b8c5" text-anchor="middle">Balance: 1,234.56 DIVI</text>
  <rect x="50" y="350" width="200" height="60" rx="8" fill="#6366f1" opacity="0.3"/>
  <text x="150" y="385" font-family="Arial, sans-serif" font-size="18" fill="#f8f9fa" text-anchor="middle">Send</text>
  <rect x="300" y="350" width="200" height="60" rx="8" fill="#8b5cf6" opacity="0.3"/>
  <text x="400" y="385" font-family="Arial, sans-serif" font-size="18" fill="#f8f9fa" text-anchor="middle">Receive</text>
  <rect x="550" y="350" width="200" height="60" rx="8" fill="#6366f1" opacity="0.3"/>
  <text x="650" y="385" font-family="Arial, sans-serif" font-size="18" fill="#f8f9fa" text-anchor="middle">Accounts</text>
</svg>
