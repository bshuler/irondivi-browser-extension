<svg width="800" height="500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="sendGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a26;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#252538;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#sendGrad)"/>
  <text x="400" y="100" font-family="Arial, sans-serif" font-size="48" fill="#6366f1" text-anchor="middle" font-weight="bold">Send DIVI</text>

  <rect x="150" y="150" width="500" height="50" rx="8" fill="#1e1e2e" stroke="#3a3a54" stroke-width="2"/>
  <text x="170" y="182" font-family="Arial, sans-serif" font-size="16" fill="#b4b8c5">To: D1abc...xyz</text>

  <rect x="150" y="220" width="500" height="50" rx="8" fill="#1e1e2e" stroke="#3a3a54" stroke-width="2"/>
  <text x="170" y="252" font-family="Arial, sans-serif" font-size="16" fill="#b4b8c5">Amount: 100.00 DIVI</text>

  <rect x="150" y="290" width="500" height="50" rx="8" fill="#1e1e2e" stroke="#3a3a54" stroke-width="2"/>
  <text x="170" y="322" font-family="Arial, sans-serif" font-size="16" fill="#b4b8c5">Fee: 0.01 DIVI</text>

  <rect x="300" y="380" width="200" height="60" rx="12" fill="#6366f1"/>
  <text x="400" y="415" font-family="Arial, sans-serif" font-size="20" fill="#ffffff" text-anchor="middle" font-weight="bold">Send Transaction</text>
</svg>
