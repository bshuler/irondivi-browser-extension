{
  "name": "irondivi-browser-extension",
  "version": "0.0.11",
  "description": "IronDivi Wallet Browser Extension",
  "type": "module",
  "engines": {
    "node": "26.6.0"
  },
  "scripts": {
    "build": "node scripts/build.js chrome",
    "build:all": "node scripts/build.js all",
    "build:dev": "IRONDIVI_DEV=1 node scripts/build.js chrome",
    "build:firefox": "node scripts/build.js firefox",
    "build:edge": "node scripts/build.js edge",
    "build:safari": "node scripts/build.js safari",
    "build:safari:app": "npm run build:safari && scripts/safari.sh",
    "watch": "node scripts/build.js chrome --watch",
    "package": "npm run build:all && node scripts/package.js",
    "package:release": "npm run package",
    "lint": "eslint src/",
    "test": "playwright test",
    "test:headed": "PW_HEADED=1 playwright test --headed",
    "test:unit": "vitest",
    "check:remote": "scripts/remote-check.sh",
    "reproduce": "scripts/reproduce.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.1.36",
    "archiver": "6.0.2",
    "esbuild": "0.20.2",
    "eslint": "8.57.1",
    "typescript": "5.9.3",
    "vitest": "1.6.1",
    "web-ext": "10.7.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@noble/secp256k1": "3.2.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@types/qrcode": "1.5.6",
    "buffer": "6.0.3",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  }
}
