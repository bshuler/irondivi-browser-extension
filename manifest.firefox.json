{
  "browser_specific_settings": {
    "gecko": {
      "id": "irondivi-wallet@divi.domains",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "provider.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
